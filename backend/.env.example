# Local development values only. Never commit your real .env.
PORT=8080
NODE_ENV=development
# Vite not needed. Allow GitHub Pages URL and local Live Server URL(s), comma-separated.
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,https://wexorawebsolutions.github.io
# Set after deploying the backend (public HTTPS). Instamojo must reach this URL.
PUBLIC_BACKEND_URL=https://shilpakar-api.onrender.com
# Supabase > Project > Connect > Session Pooler, or direct database URL. Keep private.
DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Use sandbox credentials from test.instamojo.com, NOT live credentials.
INSTAMOJO_BASE_URL = "https://www.instamojo.com",
INSTAMOJO_CLIENT_ID=
INSTAMOJO_CLIENT_SECRET=
# Private Salt for webhook MAC validation, if available. Leave blank to disable webhooks temporarily.
INSTAMOJO_PRIVATE_SALT=
# Never use production unless you have completed sandbox tests.
AMOUNT_PAISE=29900
